# Deterministic MockAgent configuration. The demo injects its own LLMClient.
A2AT_LANGUAGE=zh-CN
A2AT_PROMPT_SOURCE_TYPE=classpath
A2AT_PROMPT_RESOURCE_LOCAL_ROOT_DIR=
A2AT_LLM_PROVIDER=openai
A2AT_LLM_MODEL=demo-static-model
A2AT_LLM_BASE_URL=https://example.invalid/v1
A2AT_LLM_API_KEY=demo-only
A2AT_NEGOTIATION_STATE_STORE_TYPE=in_memory
